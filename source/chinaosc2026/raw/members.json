  {
   "id": 104,
   "typeIntroduction": "PMC（Project Management Committee）是本专区的核心组织，负责监督和管理社区项目的开发进程。PMC成员负责制定项目的战略、管理项目过程及资源、协调开发者之间的合作，确保项目按照计划运行。PMC也是指导社区繁荣发展、吸引更多的贡献者、维护良好社区氛围的关键人员",
   "typeName": "PMC（项目管理委员会）",
   "zoneMemberList": null
  },
  {
   "id": 105,
   "typeIntroduction": "Committer是一个为社区特定项目做出贡献的人员团队。通常是开源社区的有资深经验的成员，他们通常拥有专区开源项目的授权和贡献者身份，并参与到代码编写阶段，为用户和PMC成员提供技术指导和支持",
   "typeName": "Commiter（代码合作者）",
   "zoneMemberList": null
  },
  {
   "id": 106,
   "typeIntroduction": "Developer（项目开发者）是为专区开源项目编写代码，提交代码，以及维护文档等工作的成员。他们在项目开始的不同阶段参与编写代码并提出优化、建议、解决问题和错误等，以便确保项目的顺利进行",
   "typeName": "Developer（项目开发者）",
   "zoneMemberList": null
  },
  {
   "id": 107,
   "typeIntroduction": "User是使用专区开源项目的会员用户，他们通过专区官方的网站，获得与专区相关的资源、文档、项目、新闻、及参与社区交流等。同时专区会员用户也可以贡献自己的意见、反馈bug、甚至提供代码，是项目不断发展的重要基石",
   "typeName": "User（项目使用者）",
   "zoneMemberList": null
  },
